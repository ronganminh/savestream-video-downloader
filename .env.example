APP_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=INFO

# SaveStream backend -> downloader shared secret. Required in production.
INTERNAL_API_KEY=
TOKEN_SECRET=change-me-in-production

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=45
DOWNLOAD_TTL_SECONDS=300
MEDIA_REFRESH_AFTER_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_ORDER=ytdlp,cobalt,dtk

# In-process provider.
ENABLE_YTDLP=true

# Self-hosted cobalt provider. docker-compose.yml enables this by default.
COBALT_URL=http://cobalt:9000/
COBALT_API_KEY=

# Optional self-hosted Evil0ctal/Douyin_TikTok_Download_API v5.
DTK_URL=
DTK_API_KEY=
DTK_WAIT_SECONDS=12

RESOLVE_RATE_LIMIT_PER_MINUTE=30
DOWNLOAD_RATE_LIMIT_PER_MINUTE=60
MAX_DURATION_SECONDS=900
MAX_FILE_SIZE_BYTES=524288000
MAX_CAROUSEL_ITEMS=50
